# Copy this file to `.env` in the repo root and fill in your key.
# All four agents call OpenRouter using their framework's LiteLLM/OpenAI adapter.

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-agent models. Any OpenRouter model id works.
# You may write them with or without the "openrouter/" prefix.
ADMIN_MODEL=openai/gpt-4o-mini
TEXT2SQL_MODEL=openai/gpt-4o-mini
RAG_MODEL=openai/gpt-4o-mini
DEEPRESEARCH_MODEL=openai/gpt-4o-mini

# Hosts and ports (defaults shown)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=10001
TEXT2SQL_HOST=127.0.0.1
TEXT2SQL_PORT=9001
RAG_HOST=127.0.0.1
RAG_PORT=9002
DEEPRESEARCH_HOST=127.0.0.1
DEEPRESEARCH_PORT=9003
